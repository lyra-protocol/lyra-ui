PRIVY_APP_ID=
PRIVY_SECRET=
PRIVY_CLIENT_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

AZURE_OPENAI_BASE_URL=https://lyra-protocol-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# Optional alternative to AZURE_OPENAI_BASE_URL
AZURE_OPENAI_ENDPOINT=https://lyra-protocol-resource.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=Llama-4-Maverick-17B-128E-Instruct-FP8

# Optional Foundry / research / retrieval configuration
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_AGENT_ID=
AZURE_FOUNDRY_BING_CONNECTION_NAME=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_API_VERSION=2025-09-01

LYRA_AI_TRIGGER_SECRET=

# Paper trading: max leverage shown in UI / API validation (1–40). DB RPC must allow it too.
PAPER_MAX_LEVERAGE=40

# Lyra Signal feed (optional browser WebSocket). Vercel signal runs over HTTP,
# so leave this empty unless you deploy a separate WebSocket worker.
NEXT_PUBLIC_LYRA_SIGNAL_URL=

# Lyra MCP (optional). Origin only, no trailing slash. If unset, the UI defaults to
# https://lyra-mcp-vercel.vercel.app — set this only to point at another MCP host.
# NEXT_PUBLIC_LYRA_MCP_BASE_URL=https://lyra-mcp-vercel.vercel.app

# Birdeye Data Services (server-side only)
BIRDEYE_API_KEY=

# Lyra Signal worker HTTP/WS origin used by /api/signals/recent and the live feed.
# Can be https://... or wss://...; /feed is appended by the client.
LYRA_SIGNAL_URL=https://lyra-signal-vercel.vercel.app

# Lyra agent mode. Use "vercel" to run compatible Next.js API routes.
# Use "auto" to prefer LYRA_AGENT_URL and fall back when the agent is unreachable.
LYRA_AGENT_MODE=auto
LYRA_AGENT_PAPER_EQUITY_USD=10000
# LYRA_AGENT_BORN_AT=2026-05-01T00:00:00.000Z
LYRA_AGENT_URL=https://lyra-agent-vercel.vercel.app

# Server-only: used by /api/telegram/bot to resolve the public t.me link.
TELEGRAM_BOT_TOKEN=
# Optional public override if you prefer not to call Telegram getMe from Vercel.
NEXT_PUBLIC_LYRA_TELEGRAM_BOT_URL=
